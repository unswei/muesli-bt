{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muesli-bt.org/schemas/air_hockey_evidence/v1/airhockey.campaign_summary.v1.schema.json",
  "title": "Air-hockey paired campaign analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_count",
    "pair_count",
    "synthetic_only",
    "pairs",
    "integrity_intervals",
    "paired_intervals",
    "table_rows",
    "plot_fields",
    "raw_provenance_sha256"
  ],
  "properties": {
    "schema_version": {"const": "airhockey.campaign_summary.v1"},
    "run_count": {"type": "integer", "minimum": 2},
    "pair_count": {"type": "integer", "minimum": 1},
    "synthetic_only": {"type": "boolean"},
    "pairs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "integrity_intervals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_obsolete_dispatch", "full_obsolete_dispatch"],
      "properties": {
        "baseline_obsolete_dispatch": {"$ref": "#/$defs/binomial"},
        "full_obsolete_dispatch": {"$ref": "#/$defs/binomial"}
      }
    },
    "paired_intervals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obsolete_target_motion", "save_rate"],
      "properties": {
        "obsolete_target_motion": {"$ref": "#/$defs/bootstrap"},
        "save_rate": {"$ref": "#/$defs/bootstrap"}
      }
    },
    "table_rows": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "baseline", "full", "difference"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "baseline": {"type": "number"},
          "full": {"type": "number"},
          "difference": {"type": "number"}
        }
      }
    },
    "plot_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "baseline_projected_motion",
        "full_projected_motion",
        "baseline_obsolete_dispatches",
        "full_obsolete_dispatches"
      ],
      "properties": {
        "pair_id": {"type": "array", "items": {"type": "string"}},
        "baseline_projected_motion": {"type": "array", "items": {"type": "number"}},
        "full_projected_motion": {"type": "array", "items": {"type": "number"}},
        "baseline_obsolete_dispatches": {"type": "array", "items": {"type": "integer"}},
        "full_obsolete_dispatches": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "raw_provenance_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }
  },
  "$defs": {
    "binomial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence", "successes", "total", "estimate", "lower", "upper"],
      "properties": {
        "method": {"const": "clopper_pearson_exact"},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "successes": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "estimate": {"type": "number", "minimum": 0, "maximum": 1},
        "lower": {"type": "number", "minimum": 0, "maximum": 1},
        "upper": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence", "samples", "seed", "pairs", "estimate", "lower", "upper"],
      "properties": {
        "method": {"const": "paired_percentile_bootstrap"},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "samples": {"type": "integer", "minimum": 100},
        "seed": {"type": "integer", "minimum": 0},
        "pairs": {"type": "integer", "minimum": 1},
        "estimate": {"type": "number"},
        "lower": {"type": "number"},
        "upper": {"type": "number"}
      }
    }
  }
}
