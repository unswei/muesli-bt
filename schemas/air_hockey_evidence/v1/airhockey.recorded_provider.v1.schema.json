{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muesli-bt.org/schemas/air_hockey_evidence/v1/airhockey.recorded_provider.v1.schema.json",
  "title": "Air-hockey recorded provider response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "request_sha256",
    "response_sha256",
    "job_id",
    "generation",
    "captured_context_id",
    "source_observation_step",
    "action"
  ],
  "properties": {
    "schema_version": {"const": "airhockey.recorded_provider.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 1},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "response_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "job_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "captured_context_id": {
      "type": "string",
      "pattern": "^episode-[0-9]{6,}/track-[0-9]{4,}$"
    },
    "source_observation_step": {"type": "integer", "minimum": 0},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "frame", "values", "dt_ms"],
      "properties": {
        "type": {"const": "continuous"},
        "frame": {"const": "airhockey.normalised_mallet_target.v1"},
        "values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": -1.0, "maximum": 1.0}
        },
        "dt_ms": {"const": 20}
      }
    }
  }
}
