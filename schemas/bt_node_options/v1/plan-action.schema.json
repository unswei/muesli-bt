{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unswei.github.io/muesli-bt/schemas/bt_node_options/v1/plan-action.schema.json",
  "title": "plan-action BT node options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    ":name": { "type": "string" },
    ":planner": { "type": "string", "enum": [":mcts", ":mppi", ":ilqr", "mcts", "mppi", "ilqr"], "default": ":mcts" },
    ":budget_ms": { "type": "integer", "minimum": 1, "default": 20 },
    ":work_max": { "type": "integer", "minimum": 0, "default": 0, "x-muesli-aliases": [":iters_max"] },
    ":horizon": { "type": "integer", "minimum": 0, "default": 0 },
    ":dt_ms": { "type": "integer", "minimum": 0, "default": 0 },
    ":model_service": { "type": "string", "default": "toy-1d" },
    ":state_key": { "type": "string", "default": "state" },
    ":action_key": { "type": "string", "default": "action" },
    ":meta_key": { "type": "string" },
    ":seed_key": { "type": "string" },
    ":safe_action_key": { "type": "string" },
    ":safe_action": { "type": "number", "x-muesli-aliases": [":fallback_action"] },
    ":action_schema": { "type": "string" },
    ":top_k": { "type": "integer", "minimum": 0, "default": 3 },
    ":gamma": { "type": "number", "default": 0.95 },
    ":max_depth": { "type": "integer", "minimum": 0, "default": 25 },
    ":c_ucb": { "type": "number", "default": 1.2 },
    ":pw_k": { "type": "number", "default": 2.0 },
    ":pw_alpha": { "type": "number", "default": 0.5 },
    ":rollout_policy": { "type": "string", "default": "model_default" },
    ":action_sampler": { "type": "string", "default": "model_default" },
    ":lambda": { "type": "number", "default": 1.0 },
    ":sigma": { "type": "number" },
    ":sigma_key": { "type": "string" },
    ":n_samples": { "type": "integer", "minimum": 1, "default": 128 },
    ":n_elite": { "type": "integer", "minimum": 0, "default": 0 },
    ":max_iters": { "type": "integer", "minimum": 0, "default": 30 },
    ":reg_init": { "type": "number", "default": 1.0 },
    ":reg_factor": { "type": "number", "default": 10.0 },
    ":tol_cost": { "type": "number", "default": 0.0001 },
    ":tol_grad": { "type": "number", "default": 0.0001 },
    ":fd_eps": { "type": "number", "default": 0.0001 },
    ":derivatives": { "type": "string", "enum": [":analytic", ":finite_diff", "analytic", "finite_diff"], "default": ":analytic" },
    ":max_du": { "type": "number" },
    ":max_du_key": { "type": "string" },
    ":smoothness_weight": { "type": "number" },
    ":collision_weight": { "type": "number" },
    ":goal_tolerance": { "type": "number" }
  }
}
