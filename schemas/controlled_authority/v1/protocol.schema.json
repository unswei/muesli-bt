{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muesli-bt.invalid/schemas/controlled_authority/v1/protocol.schema.json",
  "title": "Controlled invocation-authority protocol v1",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "gate",
    "status",
    "identifier_policy",
    "common_task",
    "variants",
    "schedule_catalogue",
    "fault_matrix",
    "seed_sets",
    "semantic_lane",
    "timing_lane",
    "run_level_metrics",
    "oracle_precedence",
    "paper_gate"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "controlled-authority.protocol.v1"},
    "protocol_id": {"const": "controlled-authority.c0.v1"},
    "gate": {"const": "C0"},
    "status": {"const": "frozen"},
    "reader_language": {"const": "en-AU"},
    "identifier_policy": {
      "type": "object",
      "required": ["schedule_ids_are_internal", "reader_facing_field"],
      "properties": {
        "schedule_ids_are_internal": {"const": true},
        "reader_facing_field": {"const": "reader_label"},
        "paper_must_define_variants_before_using_short_labels": {"const": true}
      },
      "additionalProperties": false
    },
    "common_task": {"type": "object"},
    "variants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["variant_id", "short_label", "reader_label", "non_blocking", "deadline", "epoch_generation", "context_identity", "logical_revocation", "terminal_claim", "dispatch_revalidation"],
        "properties": {
          "variant_id": {"type": "string", "pattern": "^authority-b[0-3]-"},
          "short_label": {"type": "string", "pattern": "^B[0-3]$"},
          "reader_label": {"type": "string", "minLength": 8},
          "non_blocking": {"type": "boolean"},
          "deadline": {"type": "boolean"},
          "epoch_generation": {"type": "boolean"},
          "context_identity": {"type": "boolean"},
          "logical_revocation": {"type": "boolean"},
          "terminal_claim": {"type": ["boolean", "string"]},
          "dispatch_revalidation": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "schedule_catalogue": {"type": "string"},
    "fault_matrix": {"type": "string"},
    "seed_sets": {
      "type": "object",
      "required": ["engineering", "paper"],
      "properties": {
        "engineering": {"$ref": "#/$defs/seedSet"},
        "paper": {"$ref": "#/$defs/seedSet"}
      },
      "additionalProperties": false
    },
    "semantic_lane": {"type": "object"},
    "timing_lane": {
      "type": "object",
      "required": [
        "contract_id",
        "clock",
        "host_policy",
        "condition_design",
        "warmup_repetitions_per_condition_and_variant",
        "seed_first",
        "primary",
        "service_delay_ms",
        "tick_rate_hz",
        "concurrent_jobs",
        "delay_distributions",
        "secondary_repetitions"
      ],
      "properties": {
        "contract_id": {"const": "controlled-authority.c0.timing.v1"},
        "clock": {"const": "steady_clock"},
        "host_policy": {
          "type": "object",
          "required": [
            "selection",
            "required_fingerprint_fields",
            "background_load_must_be_recorded",
            "maximum_normalised_load_average"
          ],
          "properties": {
            "selection": {"const": "one_recorded_host_per_campaign"},
            "required_fingerprint_fields": {
              "const": [
                "hostname",
                "operating_system",
                "kernel",
                "architecture",
                "cpu_model",
                "logical_cpu_count",
                "memory_bytes",
                "cpu_affinity",
                "load_average",
                "background_processes"
              ]
            },
            "background_load_must_be_recorded": {"const": true},
            "maximum_normalised_load_average": {"const": 0.5}
          },
          "additionalProperties": false
        },
        "condition_design": {"const": "primary_plus_one_factor_at_a_time"},
        "warmup_repetitions_per_condition_and_variant": {"const": 5},
        "seed_first": {"const": 20000},
        "primary": {
          "type": "object",
          "required": [
            "service_delay_ms",
            "tick_rate_hz",
            "concurrent_jobs",
            "repetitions",
            "statistic"
          ],
          "properties": {
            "service_delay_ms": {"const": 500},
            "tick_rate_hz": {"const": 50},
            "concurrent_jobs": {"const": 1},
            "repetitions": {"const": 200},
            "statistic": {"const": "p99_of_maximum_tick_per_trial"}
          },
          "additionalProperties": false
        },
        "service_delay_ms": {"const": [0, 5, 20, 50, 100, 250, 500, 1000, 2000]},
        "tick_rate_hz": {"const": [20, 50]},
        "concurrent_jobs": {"const": [1, 4, 16]},
        "delay_distributions": {
          "const": {
            "fixed": {"values": [1.0], "probabilities": [1.0]},
            "uniform": {"minimum_multiplier": 0.0, "maximum_multiplier": 2.0},
            "bimodal": {"values": [0.5, 1.5], "probabilities": [0.5, 0.5]},
            "long_tail": {"values": [0.5, 5.5], "probabilities": [0.9, 0.1]}
          }
        },
        "secondary_repetitions": {"const": 30}
      },
      "additionalProperties": false
    },
    "run_level_metrics": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "oracle_precedence": {
      "const": ["branch_revoked", "superseded", "context_changed", "deadline_expired", "current"]
    },
    "paper_gate": {"type": "object"}
  },
  "$defs": {
    "seedSet": {
      "type": "object",
      "required": ["first", "count"],
      "properties": {
        "first": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
