{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muesli-bt.invalid/schemas/controlled_authority/v1/campaign-manifest.schema.json",
  "title": "Controlled invocation-authority campaign manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "created_at",
    "protocol_id",
    "catalogue_id",
    "matrix_id",
    "seed_set",
    "seeds",
    "schedule_internal_ids",
    "schedule_reader_labels",
    "variant_short_labels",
    "variant_reader_labels",
    "trial_count",
    "expected_outcomes_met",
    "canonical_trace_failures",
    "campaign_valid",
    "paper_gate",
    "inputs",
    "environment",
    "raw_trials",
    "run_manifests",
    "derived_artefacts",
    "manual_run_exclusion_allowed"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "controlled-authority.campaign-manifest.v1"},
    "campaign_id": {"type": "string", "pattern": "^controlled-authority-[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "protocol_id": {"type": "string", "minLength": 1},
    "catalogue_id": {"type": "string", "minLength": 1},
    "matrix_id": {"type": "string", "minLength": 1},
    "seed_set": {"enum": ["engineering", "paper", "explicit"]},
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "schedule_internal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^F(0[1-9]|1[0-6])$"}
    },
    "schedule_reader_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 12}
    },
    "variant_short_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^B[0-3]$"}
    },
    "variant_reader_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    },
    "trial_count": {"type": "integer", "minimum": 1},
    "expected_outcomes_met": {"type": "integer", "minimum": 0},
    "canonical_trace_failures": {"type": "integer", "minimum": 0},
    "campaign_valid": {"type": "boolean"},
    "paper_gate": {
      "type": "object",
      "required": ["evaluated", "passed"],
      "properties": {
        "evaluated": {"type": "boolean"},
        "passed": {"type": ["boolean", "null"]},
        "reason": {"type": "string"},
        "full_variant_obsolete_effects": {"type": "integer", "minimum": 0},
        "full_variant_false_rejections": {"type": "integer", "minimum": 0},
        "canonical_trace_failures": {"type": "integer", "minimum": 0},
        "replay_mismatches": {"type": "integer", "minimum": 0},
        "expected_outcome_failures": {"type": "integer", "minimum": 0},
        "negative_control_exposure_met": {"type": "boolean"},
        "negative_control_witnesses": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "protocol",
        "catalogue",
        "fault_matrix",
        "common_task",
        "resolved_plan",
        "engine"
      ],
      "properties": {
        "protocol": {"$ref": "#/$defs/file"},
        "catalogue": {"$ref": "#/$defs/file"},
        "fault_matrix": {"$ref": "#/$defs/file"},
        "common_task": {"$ref": "#/$defs/file"},
        "resolved_plan": {"$ref": "#/$defs/file"},
        "engine": {"$ref": "#/$defs/file"}
      },
      "additionalProperties": false
    },
    "environment": {"type": "object"},
    "raw_trials": {"$ref": "#/$defs/file"},
    "run_manifests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "derived_artefacts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/file"}
    },
    "manual_run_exclusion_allowed": {"const": false}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
