{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muesli-bt.invalid/schemas/controlled_authority/v1/btcpp-comparison-run-manifest.schema.json",
  "title": "BehaviorTree.CPP authority-comparison run manifest v1",
  "type": "object",
  "required": [
    "schema_version", "protocol_id", "schedule", "variant", "seed",
    "raw_trial_index", "paired_input_digest", "c0_profile_reference",
    "matches_c0_profile_reference", "metrics", "counts", "effects",
    "canonical_streams", "manual_exclusion"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "controlled-authority.btcpp-comparison-run-manifest.v1"},
    "protocol_id": {"const": "controlled-authority.btcpp-comparison.e1.v1"},
    "schedule": {
      "type": "object",
      "required": ["internal_id", "reader_label"],
      "properties": {
        "internal_id": {"type": "string", "pattern": "^F(0[1-9]|1[0-6])$"},
        "reader_label": {"type": "string", "minLength": 12}
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["variant_id", "manifest_label", "reader_label", "runtime_id", "authority_profile", "implementation_id"],
      "properties": {
        "variant_id": {"type": "string", "minLength": 8},
        "manifest_label": {"enum": ["MBT-ordinary", "BTCPP-ordinary", "MBT-full", "BTCPP-full"]},
        "reader_label": {"type": "string", "minLength": 16},
        "runtime_id": {"enum": ["muesli-bt", "behaviortree-cpp"]},
        "authority_profile": {"enum": ["ordinary_asynchronous", "invocation_scoped"]},
        "implementation_id": {"type": "string", "minLength": 8}
      },
      "additionalProperties": false
    },
    "seed": {"type": "integer", "minimum": 0},
    "raw_trial_index": {"type": "integer", "minimum": 1},
    "paired_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "c0_profile_reference": {"type": "string", "minLength": 5},
    "matches_c0_profile_reference": {"type": "boolean"},
    "metrics": {
      "type": "object",
      "required": ["obsolete_effect", "current_result_accepted_exactly_once", "valid_current_result_rejected", "intervention_to_fallback_ms", "maximum_tick_ms", "terminal_outcome_count", "task_replay_equal", "canonical_trace_valid"],
      "additionalProperties": true
    },
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "effects": {"type": "array", "items": {"type": "object"}},
    "canonical_streams": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256", "event_count", "canonical_trace_valid", "validation_errors"],
        "properties": {
          "kind": {"enum": ["task", "variant"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "event_count": {"type": "integer", "minimum": 1},
          "canonical_trace_valid": {"type": "boolean"},
          "validation_errors": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "manual_exclusion": {"const": false}
  },
  "additionalProperties": false
}
