{
  "$schema": "../../../schemas/controlled_authority/v1/protocol.schema.json",
  "schema_version": "controlled-authority.protocol.v1",
  "protocol_id": "controlled-authority.c0.v1",
  "gate": "C0",
  "status": "frozen",
  "reader_language": "en-AU",
  "identifier_policy": {
    "schedule_ids_are_internal": true,
    "reader_facing_field": "reader_label",
    "paper_must_define_variants_before_using_short_labels": true
  },
  "common_task": {
    "tree": "../lisp/common_task.lisp",
    "initial_context_id": "context-a",
    "request_deadline_ms": 500,
    "proposal": {
      "type": "approach_pose",
      "frame_id": "task_context",
      "dimensions": 3,
      "bounds": {
        "min": [-1.0, -1.0, -3.141593],
        "max": [1.0, 1.0, 3.141593]
      }
    },
    "fallback": "safe_wait",
    "emergency_capability": "safe_stand"
  },
  "variants": [
    {
      "variant_id": "authority-b0-blocking",
      "short_label": "B0",
      "reader_label": "blocking service call",
      "non_blocking": false,
      "deadline": false,
      "epoch_generation": false,
      "context_identity": false,
      "logical_revocation": false,
      "terminal_claim": false,
      "dispatch_revalidation": false
    },
    {
      "variant_id": "authority-b1-asynchronous",
      "short_label": "B1",
      "reader_label": "ordinary asynchronous completion",
      "non_blocking": true,
      "deadline": false,
      "epoch_generation": false,
      "context_identity": false,
      "logical_revocation": false,
      "terminal_claim": false,
      "dispatch_revalidation": false
    },
    {
      "variant_id": "authority-b2-timeout",
      "short_label": "B2",
      "reader_label": "timeout and best-effort cancellation",
      "non_blocking": true,
      "deadline": true,
      "epoch_generation": false,
      "context_identity": false,
      "logical_revocation": false,
      "terminal_claim": "partial",
      "dispatch_revalidation": false
    },
    {
      "variant_id": "authority-b3-invocation-scoped",
      "short_label": "B3",
      "reader_label": "invocation-scoped authority",
      "non_blocking": true,
      "deadline": true,
      "epoch_generation": true,
      "context_identity": true,
      "logical_revocation": true,
      "terminal_claim": true,
      "dispatch_revalidation": true
    }
  ],
  "schedule_catalogue": "../schedules/catalogue.v1.json",
  "fault_matrix": "fault-matrix.v1.json",
  "seed_sets": {
    "engineering": {
      "first": 0,
      "count": 32
    },
    "paper": {
      "first": 10000,
      "count": 128
    }
  },
  "semantic_lane": {
    "clock": "stepped",
    "ordering": "event_barriers",
    "paper_runs_per_schedule_and_variant": 128,
    "complete_schedule_is_experimental_unit": true
  },
  "timing_lane": {
    "clock": "steady_clock",
    "canonical_host": "Apple M3",
    "primary": {
      "service_delay_ms": 500,
      "tick_rate_hz": 50,
      "concurrent_jobs": 1,
      "repetitions": 200,
      "statistic": "p99_of_maximum_tick_per_trial"
    },
    "service_delay_ms": [0, 5, 20, 50, 100, 250, 500, 1000, 2000],
    "tick_rate_hz": [20, 50],
    "concurrent_jobs": [1, 4, 16],
    "delay_distributions": ["fixed", "uniform", "bimodal", "long_tail"],
    "secondary_repetitions": 30
  },
  "run_level_metrics": [
    "obsolete_effect",
    "current_result_accepted_exactly_once",
    "valid_current_result_rejected",
    "intervention_to_fallback_ms",
    "maximum_tick_ms",
    "terminal_outcome_count",
    "canonical_trace_valid",
    "task_replay_equal"
  ],
  "oracle_precedence": [
    "branch_revoked",
    "superseded",
    "context_changed",
    "deadline_expired",
    "current"
  ],
  "paper_gate": {
    "maximum_full_obsolete_effects": 0,
    "maximum_full_false_rejections": 0,
    "maximum_full_trace_failures": 0,
    "maximum_full_replay_mismatches": 0,
    "required_negative_control_exposure": true,
    "manual_run_exclusion_allowed": false
  }
}
