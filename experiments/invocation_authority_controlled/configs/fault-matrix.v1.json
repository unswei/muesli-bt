  "authority_dimension_definitions": {
    "current_admission": {
      "reader_label": "current-result admission",
      "definition": "A valid result belonging to the active request is accepted exactly once."
    },
    "non_blocking": {
      "reader_label": "non-blocking execution",
      "definition": "A pending provider call does not prevent the reactive task from processing later events."
    },
    "deadline": {
      "reader_label": "deadline authority",
      "definition": "A result loses authority only after the request's inclusive logical deadline."
    },
    "epoch_generation": {
      "reader_label": "epoch and generation identity",
      "definition": "A result belongs to the same branch epoch and request generation that created it."
    },
    "context_identity": {
      "reader_label": "observation-context identity",
      "definition": "A result belongs to the same observation context that was captured at submission."
    },
    "logical_revocation": {
      "reader_label": "logical revocation",
      "definition": "Loss of branch authority is terminal even when provider cancellation is late or ineffective."
    },
    "terminal_claim": {
      "reader_label": "exactly-once terminal ownership",
      "definition": "Only one acceptance, rejection or cancellation can own a request's terminal outcome."
    },
    "dispatch_revalidation": {
      "reader_label": "dispatch-time revalidation",
      "definition": "Authority is checked again before an accepted result reaches the walking capability."
    },
    "cancellation_ordering": {
      "reader_label": "cancellation ordering",
      "definition": "Cancellation and completion at one logical time resolve in the frozen event order."
    },
    "structural_validation": {
      "reader_label": "structural validation",
      "definition": "Malformed provider output is rejected before it can become a task-level proposal."
    },
    "host_validation": {
      "reader_label": "host validation",
      "definition": "The host checks frame, bounds, current context and stability before accepting a pose."
    },
    "provider_availability": {
      "reader_label": "provider-failure handling",
      "definition": "A provider failure becomes one explicit terminal outcome and selects the authored fallback."
    },
    "job_isolation": {
      "reader_label": "concurrent-job isolation",
      "definition": "Completions from independent task instances cannot alter another instance's state."
    },
    "job_key_isolation": {
      "reader_label": "generation-safe key reuse",
      "definition": "An older generation cannot write through or clear a key now owned by a newer request."
    },
    "reset_revocation": {
      "reader_label": "reset-time revocation",
      "definition": "Reset revokes pending work before invocation-owned state is cleared or reused."
    },
    "replay_parity": {
      "reader_label": "task-decision replay parity",
      "definition": "Recorded semantic trials reproduce the same task decisions without a live provider."
    }
  },
